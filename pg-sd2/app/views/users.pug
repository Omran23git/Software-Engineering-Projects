extends layout

block content
  h2.section-title Users
  p.small-note Users are ranked by points. Earn points by registering, messaging, and completing swaps.

  if users && users.length
    each user, index in users
      .card
        .user-rank ##{index + 1}
        h3= user.name
        p.meta Email: #{user.email}
        p.meta
          strong Points:
          span.points-badge  #{user.points} pts
        if user.bio
          p.meta Bio: #{user.bio}
        a.button-link(href=`/users/${user.id}`) View Profile
  else
    p No users found.
