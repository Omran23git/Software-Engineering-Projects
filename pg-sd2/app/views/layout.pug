doctype html
html
  head
    title= title || 'Book Swap'
    link(rel="stylesheet", href="/styles.css")
  body
    header
      h1 Book Swap
      nav
        a(href="/") Home
        a(href="/listings") Listings
        a(href="/users") Users
        if session && session.userId
          a(href="/messages") Messages
          span.nav-user  Hi, #{session.username}
          a(href="/logout") Logout
        else
          a(href="/login") Login
          a(href="/register") Register
    .container
      block content
