doctype html
html
  head
    title= title || 'BookSwap'
    link(rel="stylesheet", href="/styles.css")
    meta(name="viewport", content="width=device-width, initial-scale=1")
  body
    header.site-header
      .nav-inner
        a.nav-brand(href="/") 📚 BookSwap
        nav.nav-links
          a(href="/listings") Browse
          a(href="/users") Users
          if session && session.userId
            a(href="/messages") Messages
        .nav-actions
          if session && session.userId
            a.btn.btn-add(href="/listings/new") + Add Book
            span.nav-user= session.username
            a.btn.btn-outline-white(href="/logout") Logout
          else
            a.btn.btn-outline-white(href="/login") Login
            a.btn.btn-white(href="/register") Register
    main.main-content
      block content
