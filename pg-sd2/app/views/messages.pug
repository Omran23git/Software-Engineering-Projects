extends layout

block content
  h2.section-title Messages

  if conversations && conversations.length
    each conv in conversations
      .card.message-card
        .message-header
          strong
            a(href=`/users/${conv.other_user_id}`)= conv.other_name
          if conv.unread_count > 0
            span.badge  #{conv.unread_count} new
        if conv.listing_title
          p.meta.small-note Re: #{conv.listing_title}
        p.message-preview= conv.last_message
        a.button-link(href=`/messages/conversation/${conv.other_user_id}`) View Conversation
  else
    p You have no messages yet.
    p.small-note Start a conversation by visiting a #[a(href="/listings") book listing] and messaging the owner.
