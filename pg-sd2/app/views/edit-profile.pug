extends layout

block content
  .container
    .page-header
      h2.section-title Edit Profile

    if error
      p.error-message= error

    form.auth-form(action="/profile/edit", method="POST")
      .form-group
        label(for="name") Name *
        input#name(type="text", name="name", required, value=user.name)

      .form-group
        label(for="bio") Bio
        textarea#bio(name="bio", rows="4", placeholder="Tell other readers about yourself...")= user.bio || ''

      hr.form-divider

      p.field-hint Leave password fields blank to keep your current password.

      .form-group
        label(for="password") New Password
        input#password(type="password", name="password", minlength="6", placeholder="Enter new password...")

      .form-group
        label(for="confirmPassword") Confirm New Password
        input#confirmPassword(type="password", name="confirmPassword", placeholder="Repeat new password...")

      .form-actions
        button.btn.btn-primary(type="submit") Save Changes
        a.btn.btn-ghost(href=`/users/${user.id}`) Cancel
