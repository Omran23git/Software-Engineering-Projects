extends layout

block content
  .hero
    .hero-content
      h1 Find Your Next Great Read
      p Swap books with readers in your community. List your books, discover new ones, and connect with fellow readers.
      .hero-stats
        .stat
          span.stat-number= availableCount
          span.stat-label Books Available
        .stat
          span.stat-number= userCount
          span.stat-label Readers
      .hero-actions
        a.btn.btn-hero-primary(href="/listings") Browse Books
        if !(session && session.userId)
          a.btn.btn-hero-outline(href="/register") Join Free

  .container
    .features-grid
      .feature-card
        .feature-icon 🔍
        h3 Discover Books
        p Browse books listed by readers. Filter by category or search by title and author.
        a.btn.btn-primary(href="/listings") Browse Now
      .feature-card
        .feature-icon 💬
        h3 Message Owners
        p Found a book you want? Message the owner directly and arrange a swap.
        if session && session.userId
          a.btn.btn-primary(href="/messages") My Messages
        else
          a.btn.btn-primary(href="/register") Get Started
      .feature-card
        .feature-icon ⭐
        h3 Earn Points
        p Build your reputation. Earn points for listing books, messaging, and completing swaps.
        a.btn.btn-primary(href="/users") Leaderboard
