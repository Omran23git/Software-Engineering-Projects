doctype html
html
  head
    title User Profile
    link(rel="stylesheet", href="/styles.css")
  body
    header
      h1 Book Swap
      nav
        a(href="/") Home
        a(href="/listings") Listings
        a(href="/users") Users

    .container
      if user
        h2.section-title= user.name

        .card
          p.meta
            strong Email:
            |  #{user.email}

          p.meta
            strong Points:
            |  #{user.points}

          if user.bio
            p.meta
              strong Bio:
              |  #{user.bio}

          form(action=`/users/${user.id}/points`, method="POST")
            button.button-link(type="submit") Award 5 Points

        if listings && listings.length
          h3 User Listings
          each listing in listings
            .card
              h4= listing.title
              if listing.author
                p.meta Author: #{listing.author}
              if listing.status
                p.meta Status: #{listing.status}
              a.button-link(href=`/book/${listing.id}`) View Listing
        else
          p This user has no listings yet.

        a.button-link(href="/users") Back to Users
      else
        p User not found.